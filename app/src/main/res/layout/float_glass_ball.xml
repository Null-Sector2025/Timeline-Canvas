<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.skydoves.cloudy.CloudyView
        android:id="@+id/glass_float_ball"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:background="@drawable/glass_circle_bg"/>

    <LinearLayout
        android:id="@+id/float_menu_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_toEndOf="@id/glass_float_ball"
        android:visibility="gone"
        android:layout_marginStart="10dp">

        <com.skydoves.cloudy.CloudyView
            android:id="@+id/menu_mark"
            android:layout_width="85dp"
            android:layout_height="40dp"
            android:padding="8dp"/>

        <com.skydoves.cloudy.CloudyView
            android:id="@+id/menu_stop"
            android:layout_width="85dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:layout_marginStart="6dp"/>

    </LinearLayout>

</FrameLayout>
